<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cr.ac.proyecto.controller.ConsultaController"
            styleClass="raiz">
    <top>
        <VBox styleClass="encabezado">
            <Label text="Consultar encuentros" styleClass="titulo"/>
            <Label text="Listado de partidos por torneo y estado" styleClass="subtitulo"/>
        </VBox>
    </top>
    <center>
        <VBox spacing="12">
            <padding><Insets top="16" right="24" bottom="16" left="24"/></padding>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="Torneo:" styleClass="etiqueta"/>
                <ComboBox fx:id="cbTorneo" onAction="#filtrar" prefWidth="200"/>
                <Label text="Estado:" styleClass="etiqueta"/>
                <ComboBox fx:id="cbEstado" onAction="#filtrar" prefWidth="160" promptText="Todos"/>
                <Button text="Quitar filtro de estado" onAction="#quitarFiltro" styleClass="boton-secundario"/>
            </HBox>
            <TableView fx:id="tblEncuentros" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colFecha" text="Fecha" prefWidth="110"/>
                    <TableColumn fx:id="colLocal" text="Local" prefWidth="130"/>
                    <TableColumn fx:id="colMarcador" text="Marcador" prefWidth="90"/>
                    <TableColumn fx:id="colVisitante" text="Visitante" prefWidth="130"/>
                    <TableColumn fx:id="colArbitro" text="Árbitro" prefWidth="150"/>
                    <TableColumn fx:id="colEstado" text="Estado" prefWidth="120"/>
                </columns>
            </TableView>
            <Label fx:id="lblTotal"/>
        </VBox>
    </center>
    <bottom>
        <HBox styleClass="pie" spacing="12" alignment="CENTER_RIGHT">
            <Button text="Volver al menú" onAction="#volver" styleClass="boton-secundario"/>
        </HBox>
    </bottom>
</BorderPane>
