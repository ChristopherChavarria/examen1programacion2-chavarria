<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cr.ac.proyecto.controller.RegistroController"
            styleClass="raiz">
    <top>
        <VBox styleClass="encabezado">
            <Label text="Programar encuentro" styleClass="titulo"/>
            <Label text="Registre un nuevo partido dentro de un torneo" styleClass="subtitulo"/>
        </VBox>
    </top>
    <center>
        <VBox alignment="TOP_CENTER" spacing="12">
            <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>
            <GridPane styleClass="formulario" maxWidth="560">
                <columnConstraints>
                    <ColumnConstraints minWidth="140"/>
                    <ColumnConstraints minWidth="300"/>
                </columnConstraints>

                <Label text="Torneo:" styleClass="etiqueta" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <ComboBox fx:id="cbTorneo" onAction="#seleccionarTorneo" maxWidth="Infinity"
                          promptText="Seleccione un torneo" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Equipo local:" styleClass="etiqueta" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <ComboBox fx:id="cbLocal" maxWidth="Infinity" promptText="Seleccione el equipo local"
                          GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Equipo visitante:" styleClass="etiqueta" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <ComboBox fx:id="cbVisitante" maxWidth="Infinity" promptText="Seleccione el equipo visitante"
                          GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Fecha:" styleClass="etiqueta" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <DatePicker fx:id="dpFecha" maxWidth="Infinity" promptText="Seleccione la fecha"
                            GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                <Label text="Árbitro:" styleClass="etiqueta" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <ComboBox fx:id="cbArbitro" maxWidth="Infinity" promptText="Seleccione el árbitro"
                          GridPane.rowIndex="4" GridPane.columnIndex="1"/>
            </GridPane>
            <Label fx:id="lblMensaje" wrapText="true" maxWidth="560"/>
        </VBox>
    </center>
    <bottom>
        <HBox styleClass="pie" spacing="12" alignment="CENTER_RIGHT">
            <Button text="Volver al menú" onAction="#volver" styleClass="boton-secundario"/>
            <Button text="Limpiar" onAction="#limpiar" styleClass="boton-secundario"/>
            <Button text="Programar encuentro" onAction="#programar" styleClass="boton-principal"/>
        </HBox>
    </bottom>
</BorderPane>
