<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cr.ac.proyecto.controller.GestionController"
            styleClass="raiz">
    <top>
        <VBox styleClass="encabezado">
            <Label text="Resultados y posiciones" styleClass="titulo"/>
            <Label text="Registre resultados, cancele encuentros y consulte la tabla" styleClass="subtitulo"/>
        </VBox>
    </top>
    <center>
        <VBox spacing="12">
            <padding><Insets top="16" right="24" bottom="16" left="24"/></padding>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="Torneo:" styleClass="etiqueta"/>
                <ComboBox fx:id="cbTorneo" onAction="#seleccionarTorneo" prefWidth="220"/>
            </HBox>
            <HBox spacing="16" VBox.vgrow="ALWAYS">
                <VBox spacing="8" HBox.hgrow="ALWAYS">
                    <Label text="Encuentros programados" styleClass="seccion"/>
                    <TableView fx:id="tblProgramados" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colFecha" text="Fecha" prefWidth="100"/>
                            <TableColumn fx:id="colLocal" text="Local" prefWidth="120"/>
                            <TableColumn fx:id="colVisitante" text="Visitante" prefWidth="120"/>
                        </columns>
                    </TableView>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="Goles local:" styleClass="etiqueta"/>
                        <TextField fx:id="txtLocal" prefWidth="50"/>
                        <Label text="Goles visitante:" styleClass="etiqueta"/>
                        <TextField fx:id="txtVisitante" prefWidth="50"/>
                    </HBox>
                    <HBox spacing="8">
                        <Button text="Registrar resultado" onAction="#registrarResultado" styleClass="boton-principal"/>
                        <Button text="Cancelar encuentro" onAction="#cancelarEncuentro" styleClass="boton-secundario"/>
                    </HBox>
                </VBox>
                <VBox spacing="8" prefWidth="300">
                    <Label text="Tabla de posiciones" styleClass="seccion"/>
                    <TableView fx:id="tblPosiciones" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colPosicion" text="#" prefWidth="40"/>
                            <TableColumn fx:id="colEquipo" text="Equipo" prefWidth="150"/>
                            <TableColumn fx:id="colPuntos" text="Puntos" prefWidth="80"/>
                        </columns>
                    </TableView>
                </VBox>
            </HBox>
            <Label fx:id="lblMensaje" wrapText="true"/>
        </VBox>
    </center>
    <bottom>
        <HBox styleClass="pie" spacing="12" alignment="CENTER_RIGHT">
            <Button text="Volver al menú" onAction="#volver" styleClass="boton-secundario"/>
        </HBox>
    </bottom>
</BorderPane>
